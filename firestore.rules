rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Protected entitlement fields that can only be set via the Admin SDK (e.g. RevenueCat webhook)
    function protectedFields() {
      return ['isPremium', 'premiumExpiresAt', 'premiumProductId', 'premiumUpdatedAt', 'premiumWillRenew', 'premiumEnvironment'];
    }

    function hasNoProtectedFields(data) {
      return !data.keys().hasAny(protectedFields()) || 
             (!data.keys().hasAny(['premiumExpiresAt', 'premiumProductId', 'premiumUpdatedAt', 'premiumWillRenew', 'premiumEnvironment']) && data.isPremium == false);
    }

    function doesNotModifyProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields());
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && hasNoProtectedFields(request.resource.data);
      allow update: if isOwner(userId) && doesNotModifyProtectedFields();
      allow delete: if isOwner(userId);
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && hasNoProtectedFields(request.resource.data);
      allow update: if isOwner(userId) && doesNotModifyProtectedFields();
      allow delete: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
